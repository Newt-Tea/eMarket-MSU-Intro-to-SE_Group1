{
  "image": "mcr.microsoft.com/devcontainers/universal:2", // Base image for the dev container
  "hostRequirements": {
    "cpus": 4 // Minimum CPU requirement
  },
  "waitFor": "onCreateCommand", // Wait before running post-create commands
  "updateContentCommand": "cd eMarket && pip install -r requirements.txt && python manage.py migrate || echo 'Migration failed'", // Change directory, install dependencies and run migrations
  "postCreateCommand": "cd eMarket && cp .env.example .env || echo '.env file copy failed'", // Change directory and copy environment variables file
  "postStartCommand": "cd eMarket && python manage.py collectstatic --noinput || echo 'Collect static failed'", // Change directory and collect static files
  "postAttachCommand": {
    "server": "cd eMarket && python manage.py runserver" // Change directory and start the server
  },
  "customizations": {
    "vscode": {
      "workspaceFolder": "/eMarket", // Workspace folder
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-python.debugpy",
        "github.copilot"// Added extensions for better development experience
      ],
      "settings": {
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.autoImportCompletions": true
      }
    }
  },
  "portsAttributes": {
    "8000": {
      "label": "Application",
      "onAutoForward": "openPreview" // Automatically open preview when port is forwarded
    }
  },
  "forwardPorts": [8000], // Ports to forward
  "runArgs": ["-e", "DJANGO_DEBUG=True"] // Environment variables
}
