al_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">BEGIN TRANSACTION;
CREATE TABLE IF NOT EXISTS &quot;Order&quot; (
	&quot;UserID&quot;	INTEGER NOT NULL,
	&quot;Date Ordered&quot;	DATE NOT NULL,
	&quot;Ordered Items&quot;	INTEGER NOT NULL,
	FOREIGN KEY(&quot;UserID&quot;) REFERENCES &quot;User&quot;(&quot;id&quot;),
	FOREIGN KEY(&quot;Ordered Items&quot;) REFERENCES &quot;Product&quot;(&quot;id&quot;)
);
CREATE TABLE IF NOT EXISTS &quot;Product&quot; (
	&quot;id&quot;	INTEGER NOT NULL,
	&quot;ProductName&quot;	TEXT NOT NULL,
	&quot;Price&quot;	FLOAT(10, 2) NOT NULL,
	&quot;Stock&quot;	INTEGER,
	PRIMARY KEY(&quot;id&quot;)
);
CREATE TABLE IF NOT EXISTS &quot;User&quot; (
	&quot;id&quot;	INTEGER NOT NULL,
	&quot;Username&quot;	varchar(10) NOT NULL UNIQUE,
	&quot;Password&quot;	varchar(10) NOT NULL,
	PRIMARY KEY(&quot;id&quot;)
);
INSERT INTO &quot;Product&quot; (&quot;id&quot;,&quot;ProductName&quot;,&quot;Price&quot;,&quot;Stock&quot;) VALUES 
 (1544,'GI Joe Action Figure',26.1,9),
 (2662,'Lego Set',87.26,4),
 (3215,'Chips',2.69,20),
 (5986,'Bottled Water',1.17,45),
 (7412,'Graphic Tee',32.99,5),
 (7845,'Dog Collar',3.45,15);
